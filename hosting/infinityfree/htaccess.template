Options -Indexes
DirectoryIndex index.html
AddType application/javascript .js .mjs
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^api/(?:config|owner)\.php$ - [F,L]
RewriteRule ^(?:\.git|\.env|tests|scripts|artifacts|releases)(?:/|$) - [F,L]
RewriteRule ^docs/(?!sources(?:/|$)) - [F,L]
RewriteRule \.(?:sqlite3?|db|dpapi|pem|key|py|ps1|bat|log|bak)$ - [F,L,NC]
RewriteRule ^(assets/.*\.(?:mp4|webm|mov))$ https://raw.githubusercontent.com/Rodiidii/Astralis/v1.0.58/$1 [R=302,L,NE,NC]
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.+\.js)$ $1.gz [L]
RewriteRule ^api/router\.php$ - [L]
RewriteRule ^api/ api/router.php [L,QSA]
</IfModule>
<FilesMatch "\.js\.gz$">
ForceType application/javascript
<IfModule mod_headers.c>
Header set Content-Encoding gzip
</IfModule>
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/json image/svg+xml
</IfModule>
